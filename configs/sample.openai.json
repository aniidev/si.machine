{
  "app": {
    "name": "OpenAI Compatible Demo"
  },
  "input": {
    "type": "text-file",
    "options": {
      "path": "examples/input/sample-note.txt"
    }
  },
  "processing": {
    "type": "raw-text"
  },
  "ai": {
    "type": "openai-compatible",
    "options": {
      "apiKeyEnv": "OPENAI_API_KEY",
      "baseUrl": "https://api.openai.com/v1",
      "model": "gpt-4.1-mini",
      "systemPrompt": "You are a concise desktop assistant. Return useful, structured guidance."
    }
  },
  "output": {
    "type": "cli"
  }
}
